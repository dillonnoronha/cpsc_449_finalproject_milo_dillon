DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/task_manager

# Supply a random secret of at least 32 bytes for login and protected routes.
JWT_SECRET=

# Optional comma-separated frontend origins for cross-origin browser requests.
FRONTEND_ORIGINS=

# Optional credentials used only by the local demo provisioning script.
DEMO_USER_PASSWORD=
DEMO_ADMIN_PASSWORD=
